cabal-version:       3.0
name:                agda-graph-explorer
version:             1.1
author:              Orestis Melkonian, Carlos Tomé Cortiñas, and Martín Ceresa
category:            Language, Development
build-type:          Simple
synopsis:            Consumers of the agda-deps dependency graph: unused-import
                     analysis, graph-level optimisation analyses, a goal-state
                     driver, and an interactive MCP explorer.

extra-doc-files:    README.md

data-files:         scripts/fiedler_helper.py

source-repository head
  type:     git
  location: https://github.com/input-output-hk/agda-graph-explorer.git

-- Shared typed view of the v2 expanded graph.json + in-memory Index.
-- Consumed by agda-unused, agda-optimization, and agda-explore.
library agda-graph
  visibility:       public
  hs-source-dirs:   src-agda-graph
  exposed-modules:  AgdaGraph.Schema
                    AgdaGraph.Index
                    AgdaGraph.WL
                    AgdaGraph.Similarity
                    AgdaGraph.ConfigCore
  build-depends:    base >= 4.10 && < 4.23,
                    aeson >= 2.0 && < 3,
                    bytestring,
                    containers,
                    unordered-containers,
                    vector,
                    text,
                    deepseq,
                    directory,
                    filepath,
                    yaml >= 0.11 && < 0.12,
                    parallel >= 3.2 && < 3.4
  default-language: Haskell2010
  ghc-options:      -Wall -O2

executable agda-unused
  ghc-options:         -O2 -threaded -rtsopts "-with-rtsopts=-N" -Wall
  hs-source-dirs:      src
  main-is:             MainUnused.hs
  other-modules:       AgdaUnused.Analysis
                       AgdaUnused.Config
                       AgdaUnused.Json
                       AgdaUnused.Source
  build-depends:       base >= 4.10 && < 4.23,
                       agda-graph,
                       aeson >= 2.0 && < 3,
                       async >= 2.2 && < 2.3,
                       bytestring,
                       containers,
                       deepseq,
                       directory,
                       filepath,
                       parallel >= 3.2 && < 3.4,
                       text,
                       yaml >= 0.11 && < 0.12
  default-language:    Haskell2010

executable agda-goals
  ghc-options:         -O2 -threaded -rtsopts "-with-rtsopts=-N" -Wall
  hs-source-dirs:      src
  main-is:             MainGoals.hs
  other-modules:       AgdaGoals.Bucket
                       AgdaGoals.Canon
                       AgdaGoals.Config
                       AgdaGoals.Driver
                       AgdaGoals.Protocol
  build-depends:       base >= 4.10 && < 4.23,
                       agda-graph,
                       aeson >= 2.0 && < 3,
                       bytestring,
                       containers,
                       deepseq,
                       directory,
                       filepath,
                       murmur-hash >= 0.1 && < 0.2,
                       process >= 1.6 && < 2,
                       text,
                       yaml >= 0.11 && < 0.12
  default-language:    Haskell2010

executable agda-explore
  ghc-options:         -O2 -threaded -Wall
  hs-source-dirs:      src
  main-is:             MainMcp.hs
  other-modules:       Paths_agda_graph_explorer
                       BuildInfo
                       BuildInfoTH
                       AgdaMcp.Config
                       AgdaMcp.Rpc
                       AgdaMcp.State
                       AgdaMcp.Query
                       AgdaMcp.Tools
  autogen-modules:     Paths_agda_graph_explorer
  build-depends:       base >= 4.10 && < 4.23,
                       agda-graph,
                       aeson >= 2.0 && < 3,
                       bytestring,
                       containers,
                       deepseq,
                       directory,
                       filepath,
                       fsnotify >= 0.4 && < 0.5,
                       process >= 1.6 && < 2,
                       template-haskell,
                       text,
                       time,
                       vector,
                       yaml >= 0.11 && < 0.12
  default-language:    Haskell2010

executable agda-optimization
  ghc-options:         -O2 -threaded -rtsopts "-with-rtsopts=-N" -Wall
  hs-source-dirs:      src
  main-is:             MainOptimization.hs
  other-modules:       AgdaOptimization.CLI
                       AgdaOptimization.CLIParse
                       AgdaOptimization.FlagSpec
                       AgdaOptimization.Config
                       AgdaOptimization.Report
                       AgdaOptimization.Motif
                       AgdaOptimization.LoadBearing
                       AgdaOptimization.Polyglot
                       AgdaOptimization.Fingerprint
                       AgdaOptimization.Debt
                       AgdaOptimization.Basket
                       AgdaOptimization.Ledger
                       AgdaOptimization.Echo
                       AgdaOptimization.Gravity
                       AgdaOptimization.Pyre
                       AgdaOptimization.Chokepoint
                       AgdaOptimization.Silhouette
                       AgdaOptimization.Entwine
                       AgdaOptimization.Fiedler
                       AgdaOptimization.Horizon
                       AgdaOptimization.Strata
                       AgdaOptimization.TermCluster
                       AgdaOptimization.ConceptBundle
                       AgdaOptimization.FamilyFilter
                       AgdaOptimization.Common
                       AgdaOptimization.Condense
                       AgdaOptimization.UnionFind
                       AgdaOptimization.Cluster
                       Paths_agda_graph_explorer
  autogen-modules:     Paths_agda_graph_explorer
  build-depends:       base >= 4.10 && < 4.23,
                       agda-graph,
                       aeson >= 2.0 && < 3,
                       async >= 2.2 && < 2.3,
                       bytestring,
                       containers,
                       unordered-containers,
                       vector,
                       text,
                       deepseq,
                       filepath,
                       directory,
                       process >= 1.6 && < 2,
                       parallel >= 3.2 && < 3.4,
                       regex-tdfa >= 1.3 && < 1.4,
                       yaml >= 0.11 && < 0.12
  default-language:    Haskell2010
